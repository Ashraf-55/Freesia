# SQLite — local database file, lives inside prisma/dev.db
DATABASE_URL="file:./dev.db"

# Auth.js
AUTH_SECRET="generate-a-random-secret-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Formspree — contact form + newsletter (notifications only, NOT a DB replacement)
FREESIA_FORMSPREE_ENDPOINT="https://formspree.io/f/xxxxxxxx"

# Transactional email (Forgot Password reset links). Works with any SMTP
# provider — Gmail (use an App Password, not your normal password),
# SendGrid, Mailgun, Amazon SES SMTP, your host's SMTP, etc.
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="apikey-or-username"
EMAIL_PASSWORD="your-smtp-password-or-api-key"
EMAIL_FROM="Freesia <no-reply@freesia.example>"
